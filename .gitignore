# 판례 RAG 벡터 인덱스 (재생성 산출물 — scripts/ingest_precedents.py로 재구축)
backend/data/precedents/index/

# 공시가격·기준시가 원본 CSV/ZIP과 변환된 SQLite (2026-08-03)
# 원본은 수 GB, SQLite도 수백 MB — git에 넣지 않는다. 정부 사이트에서 다시 받고
# scripts/build_price_db.py 로 재생성한다(README '데이터 파일 도착 후 할 일' 참고).
backend/data/price/raw/
backend/data/price/*.sqlite
backend/data/price/*.sqlite-journal
backend/data/price/*.db

# 합성 대용량 시험 파일 (scripts/make_synthetic_price_csv.py 산출물 — 절대 커밋 금지)
backend/data/price/synthetic_*.csv

# LLM 백엔드 비교 실행 산출물 (compare_llm_backends.py — 실행 시각별로 무한 증식)
# 보존할 실측치는 docs/llm-backend-comparison-<연월>.md/.json 으로 옮겨 커밋한다
backend/data/llm_bench/

