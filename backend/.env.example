# backend 환경변수 예시 파일 (이 파일은 git에 추적됨 — 실제 키를 넣지 말 것)
# 사용법: 이 파일을 복사해 backend/.env 를 만들고 실제 키 값을 채운다.
#   cp backend/.env.example backend/.env

# ── 필수 ────────────────────────────────────────────────────────────────────

# Upstage API 키 — Information Extract(등기부 추출) + Solar Pro(설명 생성) + 임베딩 공용
# 발급: console.upstage.ai > API Keys (개인 키 → 대회 공식 키 도착 시 값만 교체)
UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxxxxxxx

# ── 시세 자동 조회 (선택 — 없으면 시세를 비워 두고 사용자 입력을 받는다) ────

# 국토교통부 실거래가 공개시스템 Open API 인증키 (공공데이터포털)
# 발급: data.go.kr > 국토교통부_아파트/연립다세대/오피스텔 매매 실거래가 자료 > 활용신청
# 미설정 시 시세 조회를 건너뛴다 — 전세가율은 '확인 필요'로 남고 리포트는 그대로 완성된다.
MOLIT_API_KEY=

# ── 판례 RAG (선택 — 없으면 기본값·폴백으로 동작) ───────────────────────────

# 법제처 국가법령정보 공동활용 Open API 인증값 — 판례 대량 수집용
# 발급: open.law.go.kr 회원가입 > OPEN API 활용신청(승인 1~2일). 미설정 시 개발용 OC=test 폴백
LAW_API_OC=

# 임베딩 백엔드 강제 지정: upstage | local | hash (미설정: 키 있으면 upstage, 없으면 hash)
#PRECEDENT_EMBEDDING_BACKEND=
# 벡터 저장소 강제 지정: chroma | json (미설정: chroma, import 실패 시 json)
#PRECEDENT_VECTOR_STORE=
# 로컬 GPU 임베딩 모델 — 대량 배치 시 (기본: kakaocorp/kanana-nano-2.1b-embedding —
# 모델 사용 기준 decisions.md 2026-07-22, docs/precedent-rag.md §3)
#PRECEDENT_LOCAL_MODEL=

# ── LLM 비교 하네스 (scripts/compare_llm_backends.py — 키 미설정 프로바이더는 자동 스킵) ──

# LG K-EXAONE — FriendliAI serverless 경유 (주최 측 제공 키, flp_ 접두)
# base_url·모델명은 하네스에 기본 내장: api.friendli.ai/serverless/v1 · LGAI-EXAONE/K-EXAONE-236B-A23B
EXAONE_API_KEY=flp_xxxxxxxxxxxxxxxxxxxxxxxxx
#EXAONE_BASE_URL=
#EXAONE_MODEL=
# 기본: thinking 비활성(켜면 reasoning이 토큰 소진 — 하네스 주석 참고)
#EXAONE_EXTRA_JSON={"chat_template_kwargs": {"enable_thinking": false}}

# SKT A.X — 무료 게스트 API (키 오류로 현재 미설정, 추후 확보 예정 — 슬롯 유지)
# 공개 게스트 키: github.com/SKT-AI/A.X-4.0 > apis/README.md
# base_url·모델명은 하네스에 기본 내장: guest-api.sktax.chat/v1 · ax4
# 사용 허용: 모델 사용 기준(decisions.md 2026-07-22) ⑴⑵ 충족 (SKT 공식 배포 — Qwen 베이스 무관)
# 단 게스트 API 이용약관·레이트리밋 확인 후 연결할 것
AX_API_KEY=
#AX_BASE_URL=
#AX_MODEL=
#AX_EXTRA_JSON=

# Solar 비교용 오버라이드 (미설정 시 제품 현행값: api.upstage.ai/v1/solar · solar-pro2)
#SOLAR_BENCH_BASE_URL=
#SOLAR_BENCH_MODEL=

# Upstage 임베딩 오버라이드 (미설정 시 기본: api.upstage.ai/v1/embeddings · embedding-query/-passage)
#UPSTAGE_EMBEDDING_URL=
#UPSTAGE_EMBEDDING_QUERY_MODEL=
#UPSTAGE_EMBEDDING_PASSAGE_MODEL=

# ── LLM 그림자 로깅 (2026-08-05, 기본 OFF) ─────────────────────────────────
# 설명을 만들 때 **같은 입력으로 다른 모델도 한 번 더** 돌려 로그만 남긴다.
# 새 프롬프트·새 재료 기준의 비교 데이터를 모으기 위한 것이다.
#
# ⚠ 켜면 분석 1건마다 크레딧이 **추가로** 든다. 필요할 때만 켜라.
# ⚠ 그림자 출력은 사용자 응답에 절대 쓰이지 않는다(로그 전용).
# ⚠ 사용자 응답 지연은 없다(데몬 스레드).
#
# 켜기 :  SHADOW_LLM=exaone      (EXAONE_API_KEY 가 있어야 실제로 호출된다)
# 끄기 :  줄을 지우거나  SHADOW_LLM=off
# 읽기 :  .venv/Scripts/python.exe scripts/shadow_report.py
# 로그 :  backend/logs/llm_shadow/YYYY-MM-DD.jsonl  (.gitignore 처리됨)
# SHADOW_LLM=exaone
