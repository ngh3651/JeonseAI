<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 백엔드 서버 호출을 위한 인터넷 권한 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 카메라 권한은 두지 않는다 (2026-10-30 보안): 촬영은 휴대폰 기본 카메라 앱이 하고(image_picker 인텐트),
         그 방식은 권한이 필요 없다. 오히려 권한을 선언해 두면 첫 촬영 때 권한 창이 뜨고 거절하면 촬영이 막혔다. -->
    <!-- 계약 지킴이 알림 (2026-10-22): 안드로이드 13 이상은 알림 권한이 따로 있다.
         사용자가 잔금일·이사일을 저장하는 순간 이유와 함께 묻는다(앱을 켤 때 묻지 않는다). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 폰을 껐다 켜도 예약한 알림을 다시 건다 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- ⚠ 정확한 알람 권한(SCHEDULE_EXACT_ALARM·USE_EXACT_ALARM)은 일부러 넣지 않는다 — 구글 정책상
         달력·알람 앱이 아니면 쓰기 어렵다. 알림은 몇 분 늦게 울릴 수 있다(inexactAllowWhileIdle). -->

    <!-- 백업·기기 옮기기 끔 (2026-10-30 보안): 폰에 남는 원본 사진·실명 리포트·기기 id가 구글 백업이나
         새 폰 옮기기로 빠져나가지 않게. "원본은 이 휴대폰에만"이라는 약속을 지키는 설정이다.
         res/xml/data_extraction_rules.xml은 안드로이드 12 이상에서 기기 옮기기까지 막는다. -->
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}"><!-- http(비-HTTPS) 통신 허용 여부 — app/build.gradle.kts가 정한다: 개발 빌드는 허용(adb reverse로 http://127.0.0.1:8000), 릴리스는 서버 주소(API_BASE_URL)가 http일 때만 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 다른 앱이 주소를 붙여 우리 앱의 아무 화면(리포트·결제 등)이나 바로 열지 못하게 (2026-10-30 보안).
                 알림은 알림 내용(payload)으로, 카카오 로그인은 아래 카카오 전용 화면으로 돌아오므로 영향이 없다. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 계약 지킴이 알림 (flutter_local_notifications): 예약한 시각에 알림을 띄우는 수신기 +
             폰을 다시 켜거나 앱을 새로 설치(업데이트)했을 때 알림을 다시 거는 수신기 -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- 카카오 로그인 (2026-10-22): 카카오계정(브라우저) 로그인이 끝나면 카카오가 kakao{네이티브 앱 키}://oauth 로
             이 앱을 다시 연다. 카카오 공식 Flutter SDK 예제(example/android)와 같은 선언이다.
             스킴은 빌드 때 넣은 dart-define 값 KAKAO_NATIVE_APP_KEY로 app/build.gradle.kts가 채운다(kakaoScheme 자리).
             키가 없으면 아무도 쓰지 않는 자리 이름이 들어간다. 그때 앱은 카카오 버튼을 그리지 않는다.
             주의: XML 주석 안에는 하이픈 두 개를 이어 쓰지 않는다(매니페스트를 읽지 못해 빌드가 깨진다). -->
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="oauth" android:scheme="${kakaoScheme}" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 카카오 로그인: 카카오톡이 깔려 있는지 보고 있으면 카카오톡으로 로그인한다(안드로이드 11+ 패키지 가시성).
             SDK도 같은 선언을 갖고 있어 합쳐진다 — 여기 적어 두면 무엇을 왜 보는지 이 파일에서 바로 보인다. -->
        <package android:name="com.kakao.talk" />
        <!-- 판례 카드 사건번호 ↗: 판결문 원문(https)을 브라우저로 연다 (url_launcher, 안드로이드 11+ 패키지 가시성) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
