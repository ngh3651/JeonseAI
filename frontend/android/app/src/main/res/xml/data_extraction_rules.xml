<?xml version="1.0" encoding="utf-8"?>
<!-- 백업·기기 옮기기에서 앱 데이터를 모두 뺀다 (2026-10-30 보안, AndroidManifest의 allowBackup=false와 함께).
     안드로이드 12 이상 일부 폰은 allowBackup=false여도 기기 옮기기를 막지 않아 이 파일이 필요하다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
